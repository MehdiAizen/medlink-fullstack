{
  "realm": "medlink",
  "enabled": true,
  "displayName": "MedLink",
  "loginTheme": "medlink",
  "registrationAllowed": false,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "sslRequired": "none",
  "smtpServer": {
    "host": "${SMTP_HOST}",
    "port": "${SMTP_PORT}",
    "from": "${SMTP_FROM}",
    "fromDisplayName": "MedLink",
    "auth": "${SMTP_AUTH}",
    "ssl": "${SMTP_SSL}",
    "starttls": "${SMTP_STARTTLS}",
    "user": "${SMTP_USER}",
    "password": "${SMTP_PASSWORD}"
  },
  "roles": {
    "realm": [
      {
        "name": "patient",
        "description": "Patient MedLink"
      },
      {
        "name": "practitioner",
        "description": "Praticien MedLink"
      },
      {
        "name": "admin",
        "description": "Administrateur MedLink"
      }
    ]
  },
  "clients": [
    {
      "clientId": "medlink-app",
      "name": "MedLink Frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "rootUrl": "http://localhost:3000",
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##http://localhost:5173/*"
      }
    },
    {
      "clientId": "medlink-backend",
      "name": "MedLink Backend (Admin API)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_BACKEND_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "service-account-medlink-backend",
      "enabled": true,
      "serviceAccountClientId": "medlink-backend",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "query-users",
          "view-users",
          "view-realm"
        ]
      }
    },
    {
      "id": "11111111-1111-4111-8111-000000000001",
